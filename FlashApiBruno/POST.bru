meta {
  name: POST
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/user
  body: json
  auth: inherit
}

headers {
  X-Hub-Signature-256: sha256={{ACCESS_TOKEN}}
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:json {
  {
    "repository":{
      "full_name": "surajpheudin/sp"
    }
  }
}

settings {
  encodeUrl: true
}
